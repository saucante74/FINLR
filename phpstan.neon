includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/

    level: 5

    excludePaths:
        - app/Providers/
        # References the private saucante74\CalculatorEngine package, which is not
        # installed in every environment (see CalculatorServiceProvider).
        - app/Modules/Calculator/Services/PrivateCalculatorEngineAdapter.php

    parseModelCastsMethod: true
